{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://local/world-history/entity.schema.json",
 "title": "Timeline entity (one horizontal band of the poster)",
 "type": "array",
 "items": {
  "type": "object",
  "required": ["id", "order", "name", "y0", "y1", "start_year", "end_year", "span_count"],
  "additionalProperties": false,
  "properties": {
   "id": {"type": "string", "pattern": "^E[0-9]{3}$"},
   "order": {"type": "integer", "minimum": 0, "description": "top-to-bottom order in the poster"},
   "name": {"type": "string", "minLength": 1, "description": "band label as printed"},
   "name_zh": {"type": ["string", "null"], "description": "zh-CN translation of name; English is canonical"},
   "section": {"type": ["string", "null"], "pattern": "^SEC[0-9]{2}$"},
   "section_name": {"type": ["string", "null"]},
   "category": {
    "type": "string",
    "enum": ["state", "hunter-gatherer", "farmer", "pastoralist", "archaeological culture",
             "chiefdom", "people", "other"]
   },
   "language_family": {"type": ["string", "null"]},
   "y0": {"type": "integer", "minimum": 60, "maximum": 1990},
   "y1": {"type": "integer", "minimum": 60, "maximum": 1990},
   "start_year": {"type": "integer", "minimum": -3100, "maximum": 2000},
   "end_year": {"type": "integer", "minimum": -3100, "maximum": 2000},
   "span_count": {"type": "integer", "minimum": 1},
   "label_confidence": {"type": "string", "enum": ["high", "medium", "low"]},
   "name_source": {"type": "string", "enum": ["row-label", "span-text"]},
   "occluded_by_legend": {"type": "boolean"},
   "notes": {"type": "string"}
  }
 }
}
