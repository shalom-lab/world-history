{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://local/world-history/section.schema.json",
 "title": "A region strip of the poster (rotated label in the left margin)",
 "type": "array",
 "items": {
  "type": "object",
  "required": ["id", "name", "y0", "y1"],
  "additionalProperties": false,
  "properties": {
   "id": {"type": "string", "pattern": "^SEC[0-9]{2}$"},
   "name": {"type": "string", "minLength": 3},
   "y0": {"type": "integer", "minimum": 40, "maximum": 2010},
   "y1": {"type": "integer", "minimum": 40, "maximum": 2010},
   "label_source": {"type": "string", "enum": ["margin", "inferred"]}
  }
 }
}
